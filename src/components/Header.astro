---
import { site, nav, links } from '../data/site';
const path = Astro.url.pathname;
const av = site.availability;
---
<header class="hd">
  <div class="wrap hd-in">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <span class="brand-n">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav" id="nav-list">
        {nav.map((n) => (
          <li><a href={n.href} class:list={['nl', { on: path.startsWith(n.href) }]} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li class="m-only">
          <span class:list={['meta', 'm-st', { closed: !av.open }]}><i aria-hidden="true"></i>{av.open ? av.label : av.closedLabel}</span>
          {links.whatsapp && <a class="btn red" href={links.whatsapp} target="_blank" rel="noopener">WhatsApp {site.contact.phoneDisplay}</a>}
        </li>
      </ul>
    </nav>
    <a href="/hire/" class:list={['status', { closed: !av.open }]}>
      <i aria-hidden="true"></i><span>{av.open ? av.label : av.closedLabel}</span>
    </a>
    <button class="menu" aria-expanded="false" aria-controls="nav-list">
      <span class="menu-t">Menu</span>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu');
  const hd = document.querySelector('.hd');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    hd?.classList.toggle('open', open);
    btn.querySelector('.menu-t')!.textContent = open ? 'Close' : 'Menu';
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && hd?.classList.contains('open')) btn?.click();
  });
</script>

<style>
  .hd {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(6px);
    border-bottom: 1px solid var(--rule);
  }
  .hd-in { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 64px; gap: 20px; }
  .brand { text-decoration: none; font-family: var(--mono); font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 400; }
  .nav { display: flex; gap: 30px; list-style: none; margin: 0; padding: 0; }
  .nl { text-decoration: none; font-size: 15px; position: relative; padding: 6px 0; }
  .nl::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; background: var(--accent); transform: scaleX(0); transform-origin: 0 50%; transition: transform 0.3s var(--ease); }
  .nl:hover::after, .nl.on::after { transform: scaleX(1); }
  .status { justify-self: end; display: inline-flex; align-items: center; gap: 9px; text-decoration: none; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; }
  .status i { width: 8px; height: 8px; border-radius: 50%; background: #2f8f4e; box-shadow: 0 0 0 0 rgba(47, 143, 78, 0.5); }
  .status.closed i { background: var(--grey); }
  @media (prefers-reduced-motion: no-preference) {
    .status:not(.closed) i { animation: pulse 2.4s infinite; }
  }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(47, 143, 78, 0.45); } 70% { box-shadow: 0 0 0 7px rgba(47, 143, 78, 0); } 100% { box-shadow: 0 0 0 0 rgba(47, 143, 78, 0); } }
  .menu { display: none; }
  .m-only { display: none; }

  @media (max-width: 860px) {
    .hd-in { grid-template-columns: 1fr auto; height: 58px; }
    .status { display: none; }
    .menu { display: inline-flex; justify-self: end; background: none; border: 1.5px solid var(--ink); min-height: 40px; padding: 0 14px; align-items: center; font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }
    nav { position: absolute; inset: 58px 0 auto 0; }
    .nav { display: none; flex-direction: column; gap: 0; background: var(--paper); border-bottom: 1px solid var(--ink); padding: 8px var(--gutter) 22px; }
    .hd.open .nav { display: flex; }
    .nl { display: block; font-family: var(--serif); font-size: 36px; line-height: 1.25; padding: 8px 0; border-bottom: 1px solid var(--rule); }
    .nl::after { display: none; }
    .nl.on { color: var(--accent); }
    .brand { grid-column: 1; }
    .m-only { display: grid; gap: 14px; padding-top: 18px; }
    .m-st { display: inline-flex; align-items: center; gap: 9px; color: var(--ink); }
    .m-st i { width: 8px; height: 8px; border-radius: 50%; background: #2f8f4e; }
    .m-st.closed i { background: var(--grey); }
  }
</style>
