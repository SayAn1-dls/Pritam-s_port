---
// One shared viewer per page. Any element with [data-lb] and [data-full] opens it.
// The sequence is every *visible* [data-lb] element on the page, in DOM order,
// so archive filters automatically change what prev/next walks through.
---
<dialog class="lb" aria-label="Photo viewer">
  <div class="lb-stage">
    <div class="lb-spin meta" aria-hidden="true">Loading…</div>
    <img class="lb-img" alt="" />
  </div>
  <div class="lb-bar">
    <p class="lb-cap"><span class="lb-artist"></span> <span class="lb-text"></span></p>
    <p class="meta lb-count" aria-live="polite"></p>
  </div>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">←</button>
  <button class="lb-btn lb-next" type="button" aria-label="Next photo">→</button>
  <button class="lb-close" type="button" aria-label="Close viewer">Close ✕</button>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('dialog.lb')!;
  const img = dlg.querySelector<HTMLImageElement>('.lb-img')!;
  const artist = dlg.querySelector('.lb-artist')!;
  const text = dlg.querySelector('.lb-text')!;
  const count = dlg.querySelector('.lb-count')!;
  let list: HTMLElement[] = [];
  let i = 0;
  let opener: HTMLElement | null = null;

  const visible = (el: HTMLElement) => el.offsetParent !== null || el.getClientRects().length > 0;

  function show(n: number) {
    if (!list.length || !dlg.open) return;
    i = (n + list.length) % list.length;
    const el = list[i];
    dlg.classList.add('loading');
    img.onload = () => dlg.classList.remove('loading');
    img.onerror = () => { dlg.classList.remove('loading'); text.textContent = 'This photo could not be loaded.'; };
    img.src = el.dataset.full!;
    img.width = Number(el.dataset.w);
    img.height = Number(el.dataset.h);
    img.alt = el.dataset.alt ?? '';
    artist.textContent = el.dataset.artist ?? '';
    text.textContent = el.dataset.caption ? `— ${el.dataset.caption}` : '';
    count.textContent = `${i + 1} of ${list.length}`;
    // warm the neighbours
    [list[(i + 1) % list.length], list[(i - 1 + list.length) % list.length]].forEach((x) => {
      if (x) new Image().src = x.dataset.full!;
    });
  }

  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]');
    if (!el || !el.dataset.full) return;
    e.preventDefault();
    list = [...document.querySelectorAll<HTMLElement>('[data-lb][data-full]')].filter(visible);
    opener = el;
    dlg.showModal();
    document.documentElement.style.overflow = 'hidden';
    show(Math.max(0, list.indexOf(el)));
  });

  dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(i - 1));
  dlg.querySelector('.lb-next')!.addEventListener('click', () => show(i + 1));
  dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
  // click on the dark backdrop (not the photo or controls) closes
  dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).classList.contains('lb-stage')) dlg.close(); });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1); }
  });
  dlg.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    img.removeAttribute('src');
    opener?.focus();
  });

  // swipe
  let x0 = 0, y0 = 0;
  dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  dlg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
    if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) show(i + (dx < 0 ? 1 : -1));
    else if (dy > 90 && Math.abs(dy) > Math.abs(dx)) dlg.close();
  });
</script>

<style is:global>
  dialog.lb {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgba(12, 11, 10, 0.97); color: #f4efe4;
    display: none; grid-template-rows: 1fr auto;
  }
  dialog.lb[open] { display: grid; }
  dialog.lb::backdrop { background: rgba(12, 11, 10, 0.9); }
  @media (prefers-reduced-motion: no-preference) {
    dialog.lb[open] { animation: lbIn 0.25s var(--ease); }
    @keyframes lbIn { from { opacity: 0; } }
  }
  .lb-stage { position: relative; display: grid; place-items: center; padding: 56px 72px 8px; min-height: 0; }
  .lb-img { max-width: calc(100vw - 160px); max-height: calc(100dvh - 140px); width: auto; height: auto; object-fit: contain; user-select: none; }
  .lb.loading .lb-img { opacity: 0; }
  .lb-spin { position: absolute; display: none; color: #b8b0a3; }
  .lb.loading .lb-spin { display: block; }
  .lb-bar { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding: 14px 24px 20px; }
  .lb-cap { margin: 0; font-size: 15px; }
  .lb-artist { font-family: var(--display); font-size: 22px; text-transform: uppercase; letter-spacing: 0.02em; }
  .lb-text { color: #b8b0a3; }
  .lb-count { margin: 0; color: #b8b0a3; white-space: nowrap; }
  .lb-btn, .lb-close {
    position: absolute; background: none; border: 1px solid #4a453e; color: #f4efe4; cursor: pointer;
    font-family: var(--mono); transition: background 0.2s, border-color 0.2s;
  }
  .lb-btn { top: 50%; translate: 0 -50%; width: 48px; height: 48px; font-size: 20px; }
  .lb-btn:hover, .lb-close:hover { background: var(--accent); border-color: var(--accent); }
  .lb-prev { left: 14px; }
  .lb-next { right: 14px; }
  .lb-close { top: 12px; right: 14px; height: 40px; padding: 0 14px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  @media (max-width: 700px) {
    .lb-stage { padding: 58px 0 0; }
    .lb-img { max-width: 100vw; max-height: calc(100dvh - 160px); }
    .lb-btn { top: auto; bottom: 74px; translate: none; background: rgba(12, 11, 10, 0.6); }
    .lb-bar { flex-direction: column; gap: 4px; padding: 12px 16px 18px; }
  }
</style>
