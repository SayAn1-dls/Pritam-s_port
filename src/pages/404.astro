---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
---
<Base title="Not found">
  <section class="wrap nf">
    <div>
      <p class="meta">Error 404</p>
      <h1 class="display h">Wrong stage.</h1>
      <p class="lede">This page doesn’t exist, or it moved. The show is still on, though.</p>
      <div class="btns">
        <a class="btn" href="/">Back to the front page</a>
        <a class="btn ghost" href="/archive/">Browse the archive</a>
      </div>
    </div>
    <Photo id="cactus-dsc-0393" sizes="(max-width: 860px) 100vw, 40vw" />
  </section>
</Base>

<style>
  .nf { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center; padding-top: clamp(40px, 6vw, 90px); }
  .h { font-size: clamp(60px, 11vw, 190px); margin: 14px 0 20px; }
  .lede { margin-bottom: 28px; }
  @media (max-width: 860px) { .nf { grid-template-columns: 1fr; } }
</style>
