---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import HireCta from '../components/HireCta.astro';
import { site, companies, links } from '../data/site';
import { published } from '../data/projects';
import { photosFor } from '../data/photos';
---
<Base title="About" description={`About ${site.name}: concert and artist photographer.`}>
  <section class="wrap ab-head">
    <p class="meta">Profile</p>
    <h1 class="display h">{site.name}</h1>
    <p class="sub">Concert and artist photographer. Usually at the front of the stage.</p>
  </section>

  <section class="wrap ab-body">
    <div class="ab-photo">
      <Photo id="pritam-haldar-portrait" maxH="80svh" sizes="(max-width: 860px) 100vw, 40vw" lightbox caption />
    </div>
    <div class="ab-text prose">
      <p class="lede">I photograph live music: the artists, the performance and the energy of the night.</p>
      <p>
        I work with production companies {companies.map((c, i) => <>{i > 0 && ' and '}<strong>{c.name}</strong></>)},
        and I’ve photographed concerts by {published.map((p) => p.artist).join(', ').replace(/, ([^,]*)$/, ' and $1')}.
      </p>
      <p>
        An artist on stage is at their most honest. My job is to be ready for those moments and stay out of the
        way of the show.
      </p>
      <p>
        During a show I work the three angles that matter: the face, the stage, the crowd.
      </p>
      <p>
        Afterwards I edit the night into one consistent set, so the frames read as a single series and still hold up
        long after the show.
      </p>
      <p>
        The goal is simple: the people who weren’t there should feel the show, and wish they had been.
      </p>

      <h2 class="meta sec">How I think about it</h2>
      <ul class="beliefs">
        <li><b>The moment comes once.</b> Be ready before it happens.</li>
        <li><b>The artist comes first.</b> It is their night. The work should serve their music, not compete with it.</li>
        <li><b>The crowd is part of the show.</b> A field of raised hands says as much about a night as the stage does.</li>
        <li><b>Consistency is a brand.</b> A set should look like one night and one point of view, not fifty separate photos.</li>
      </ul>

      <h2 class="meta sec">Shows in the gallery</h2>
      <ul class="shows">
        {published.map((p) => (
          <li><a href={`/work/${p.slug}/`}><span>{p.artist}</span><span class="meta">{[p.year, `${photosFor(p.slug).length} frames online`].filter(Boolean).join(' · ')}</span></a></li>
        ))}
      </ul>

      <h2 class="meta sec">What I’m looking for</h2>
      <p>Concert and festival photography, artist shoots, and collaborations with artists and production houses who care how their shows are seen.</p>
      <div class="btns">
        <a class="btn" href="/hire/">Work with me <span class="arr">→</span></a>
        {links.instagram && <a class="btn ghost" href={links.instagram} target="_blank" rel="noopener">Instagram</a>}
      </div>
    </div>
  </section>
  <HireCta />
</Base>

<style>
  .ab-head { padding: clamp(40px, 6vw, 90px) var(--gutter) clamp(30px, 4vw, 60px); }
  .h { font-size: clamp(60px, 13vw, 220px); line-height: 0.85; letter-spacing: -0.04em; margin-top: 16px; }
  .sub { font-family: var(--sans); font-weight: 600; font-size: clamp(22px, 2.4vw, 34px); color: var(--accent); margin: 18px 0 0; max-width: 32ch; }
  .ab-body { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(30px, 6vw, 100px); align-items: start; }
  .ab-photo { position: sticky; top: 90px; }
  .ab-text { max-width: 60ch; }
  .ab-text .lede { max-width: none; margin-bottom: 1.2em; }
  .ab-text strong { font-weight: 500; }
  .sec { border-top: 6px solid var(--ink); color: var(--ink); padding-top: 10px; margin: 48px 0 16px; }
  .beliefs { list-style: none; padding: 0; margin: 0; }
  .beliefs li { padding: 14px 0; }
  .beliefs b { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: 24px; letter-spacing: 0.01em; display: block; }
  .shows { list-style: none; padding: 0; margin: 0; }
  .shows a { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding: 10px 0; text-decoration: none; font-family: var(--display); text-transform: uppercase; font-size: 30px; }
  .shows a:hover { color: var(--accent); }
  .btns { margin-top: 26px; }
  @media (max-width: 860px) {
    .ab-body { grid-template-columns: 1fr; }
    .ab-photo { position: static; }
  }
</style>
