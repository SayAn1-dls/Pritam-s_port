---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import HireCta from '../components/HireCta.astro';
import { site, companies, links } from '../data/site';
import { published } from '../data/projects';
import { photosFor } from '../data/photos';
---
<Base title="About" description={`About ${site.name}: concert photographer and show marketer working with ${companies.map((c) => c.name).join(' and ')}.`}>
  <section class="wrap ab-head">
    <p class="meta">Profile</p>
    <h1 class="display h">{site.name}</h1>
    <p class="sub">Concert photographer. Show marketer. The person in the pit with a deadline.</p>
  </section>

  <section class="wrap ab-body">
    <div class="ab-photo">
      <Photo id="pritam-haldar-portrait" ratio="4/5" sizes="(max-width: 860px) 100vw, 40vw" lightbox caption />
    </div>
    <div class="ab-text prose">
      <p class="lede">I photograph live music, and I think about every frame as something with a job to do once the show is over.</p>
      <p>
        I work with production companies {companies.map((c, i) => <>{i > 0 && ' and '}<strong>{c.name}</strong></>)},
        and I’ve photographed concerts by {published.map((p) => p.artist).join(', ').replace(/, ([^,]*)$/, ' and $1')}.
        That puts me close to everyone who needs something from a show: the artist wants to look like themselves on their best night,
        the sponsor wants proof they were there, and the organiser needs a reason for people to buy a ticket next time.
      </p>
      <p>
        So I don’t just shoot what’s in front of me. Before the show I think about who will use the pictures. During it I work the
        three angles that matter: the face, the stage, the crowd. Afterwards I edit the night into one consistent set that works
        on the artist’s feed that week and still holds up a month later in a sponsor recap.
      </p>
      <p>
        That’s the part I enjoy most, and why I’m moving further into marketing: working out what makes people show up, and then
        making sure the people who weren’t there wish they had been.
      </p>

      <h2 class="meta sec">How I think about it</h2>
      <ul class="beliefs">
        <li><b>Attention is earned in the first frame.</b> If a photo doesn’t stop the scroll, it doesn’t matter how good the show was.</li>
        <li><b>Sponsors are partners, not logos.</b> Their branding should be in the shots people share, without turning them into adverts.</li>
        <li><b>The crowd is the proof.</b> A packed field sells the next show better than any caption.</li>
        <li><b>Consistency is a brand.</b> A set should look like one night and one point of view, not fifty separate photos.</li>
      </ul>

      <h2 class="meta sec">Shows in the archive</h2>
      <ul class="shows">
        {published.map((p) => (
          <li><a href={`/work/${p.slug}/`}><span>{p.artist}</span><span class="meta">{[p.year, `${photosFor(p.slug).length} frames online`].filter(Boolean).join(' · ')}</span></a></li>
        ))}
      </ul>

      <h2 class="meta sec">What I’m looking for</h2>
      <p>Marketing, event and partnership roles with music, entertainment and lifestyle brands; concert and festival photography; and collaborations with artists and production houses who care how their shows are seen.</p>
      <div class="btns">
        <a class="btn" href="/hire/">Work with me <span class="arr">→</span></a>
        {links.linkedin && <a class="btn ghost" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
      </div>
    </div>
  </section>
  <HireCta />
</Base>

<style>
  .ab-head { padding: clamp(40px, 6vw, 90px) var(--gutter) clamp(30px, 4vw, 60px); }
  .h { font-size: clamp(60px, 13vw, 220px); line-height: 0.85; letter-spacing: -0.04em; margin-top: 16px; }
  .sub { font-family: var(--sans); font-weight: 600; font-size: clamp(22px, 2.4vw, 34px); color: var(--accent); margin: 18px 0 0; max-width: 32ch; }
  .ab-body { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(30px, 6vw, 100px); align-items: start; }
  .ab-photo { position: sticky; top: 90px; }
  .ab-text { max-width: 60ch; }
  .ab-text .lede { max-width: none; margin-bottom: 1.2em; }
  .ab-text strong { font-weight: 500; }
  .sec { border-top: 1px solid var(--ink); color: var(--ink); padding-top: 10px; margin: 48px 0 16px; }
  .beliefs { list-style: none; padding: 0; margin: 0; }
  .beliefs li { padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .beliefs b { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: 24px; letter-spacing: 0.01em; display: block; }
  .shows { list-style: none; padding: 0; margin: 0; }
  .shows a { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--rule); text-decoration: none; font-family: var(--display); text-transform: uppercase; font-size: 30px; }
  .shows a:hover { color: var(--accent); }
  .btns { margin-top: 26px; }
  @media (max-width: 860px) {
    .ab-body { grid-template-columns: 1fr; }
    .ab-photo { position: static; }
  }
</style>
