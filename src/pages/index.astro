---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import HireCta from '../components/HireCta.astro';
import Hero from '../components/home/Hero.astro';
import ShowLedger from '../components/home/ShowLedger.astro';
import { ledger } from '../data/home';
import { published } from '../data/projects';
import { photos, photoById, SELF } from '../data/photos';

const featured = published.filter((p) => p.featured);
// Layout follows each cover's own shape, so no cover is ever cropped to fit:
// wide frames alternate between the two wide compositions, tall frames between the two side-by-side ones.
let wide = 0, tall = 0;
const layoutFor = (id: string) => {
  const c = photoById(id);
  if (c && c.width > c.height) return wide++ % 2 ? 'wk-2' : 'wk-0';
  return tall++ % 2 ? 'wk-3' : 'wk-1';
};
const layouts = featured.map((p) => layoutFor(p.cover));
// Real counts, computed from the content files (not typed in by hand).
const galleryCount = photos.filter((p) => p.project !== SELF).length;
const sheet = ['cactus-dsc-0393', 'fossils-dsc-2352-l', 'monali-thakur-img-0908-l', 'jeet-ganguly-dsc-0103', 'fakira-dsc-0918', 'anupam-roy-905730', 'cactus-dsc-0241', 'fossils-dsc-2339-l']
  .map(photoById).filter(Boolean);
---
<Base>
  <Hero />
  <ShowLedger id="shows" {...ledger} />

  <!-- ============ SELECTED WORK ============ -->
  <section id="work" class="work wrap">
    <div class="label"><span class="meta">Selected work</span><span class="meta">{featured.length} shows</span></div>

    {featured.map((p, i) => (
      <article class:list={['wk', layouts[i], 'rv']}>
        <a href={`/work/${p.slug}/`} class="wk-img" aria-label={`${p.artist}: read more`}>
          <Photo id={p.cover} maxH="82svh" sizes="(max-width: 860px) 100vw, 60vw" />
        </a>
        <div class="wk-txt">
          <p class="meta wk-n">{p.genre}</p>
          <h2 class="h2"><a href={`/work/${p.slug}/`}>{p.artist}</a></h2>
          <p class="wk-kick">{p.kicker}</p>
          <p class="wk-sum">{p.summary}</p>
          <p class="meta">{[p.role, p.year].filter(Boolean).join(' · ')}</p>
          <a class="link-u wk-more" href={`/work/${p.slug}/`}>About {p.kind === 'band' ? 'the band' : 'the artist'} →</a>
        </div>
      </article>
    ))}
    <p class="work-all"><a class="btn ghost" href="/work/">All work <span class="arr">→</span></a></p>
  </section>

  <!-- ============ APPROACH (dark) ============ -->
  <section class="approach">
    <div class="wrap">
      <div class="label inv"><span class="meta">How I work a show</span><span class="meta">Three layers, every set</span></div>
      <h2 class="h2 ap-h rv">Three layers, every song.</h2>
      <ol class="ap-list">
        <li class="rv">
          <Photo id="monali-thakur-img-0886-l" sizes="(max-width: 860px) 100vw, 30vw" />
          <p class="meta">The face</p>
          <h3 class="h3">The artist</h3>
          <p>I follow the artist through the whole set, ready for the moments that matter.</p>
        </li>
        <li class="rv">
          <Photo id="jeet-ganguly-dsc-0100" sizes="(max-width: 860px) 100vw, 30vw" />
          <p class="meta">The stage</p>
          <h3 class="h3">The performance</h3>
          <p>The band and the show as a whole, from the first song to the encore.</p>
        </li>
        <li class="rv">
          <Photo id="fakira-dsc-0823" sizes="(max-width: 860px) 100vw, 30vw" />
          <p class="meta">The crowd</p>
          <h3 class="h3">The energy</h3>
          <p>The people who came, singing every word back to the stage.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ ABOUT PREVIEW ============ -->
  <section class="aboutp wrap">
    <div class="label"><span class="meta">About</span></div>
    <div class="ab-grid">
      <p class="display ab-quote rv">I stand where the crowd can’t, so the people who weren’t there <em>wish they had been.</em></p>
      <div class="ab-txt rv">
        <p>I photograph concerts and the artists who play them, from the front of the stage to the back of the crowd.</p>
        <p>I stay close to the performance and out of the way of the show.</p>
        <p>Every show is different, and every set gets photographed as one story, from the first song to the encore.</p>
        <a class="link-u" href="/about/">More about me →</a>
      </div>
    </div>
  </section>

  <!-- ============ ARCHIVE PREVIEW (contact sheet) ============ -->
  <section class="sheet wrap">
    <div class="label"><span class="meta">From the gallery</span><span class="meta">{galleryCount} frames online</span></div>
    <div class="sheet-grid">
      {sheet.map((p, i) => (
        <figure class:list={['sh', `sh-${i}`, 'rv']}>
          <Photo id={p!.id} sizes="(max-width: 860px) 50vw, 25vw" lightbox />
          <figcaption class="meta">{p!.artist}</figcaption>
        </figure>
      ))}
    </div>
    <p class="sheet-more"><a class="btn" href="/gallery/">Open the gallery <span class="arr">→</span></a></p>
  </section>

  <HireCta />
</Base>

<style>
  /* work */
  .work { padding-top: clamp(80px, 10vw, 150px); }
  .wk { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 20px; align-items: end; margin-bottom: clamp(70px, 9vw, 140px); }
  .wk-img { display: block; }
  .wk-0 .wk-img { grid-column: 1 / 9; }
  .wk-0 .wk-txt { grid-column: 9 / 13; }
  .wk-1 .wk-img { grid-column: 6 / 12; grid-row: 1; }
  .wk-1 .wk-txt { grid-column: 1 / 6; grid-row: 1; align-self: center; padding-right: 20px; }
  .wk-3 .wk-img { grid-column: 2 / 8; grid-row: 1; }
  .wk-3 .wk-txt { grid-column: 8 / 13; grid-row: 1; align-self: center; padding-left: 20px; }
  .wk-2 .wk-img { grid-column: 2 / 13; }
  .wk-2 .wk-txt { grid-column: 2 / 9; margin-top: 22px; display: grid; grid-template-columns: 1fr 1fr; column-gap: 30px; }
  .wk-2 .wk-txt > :is(.wk-n, .h2) { grid-column: 1 / -1; }
  .wk-txt .h2 a { text-decoration: none; }
  .wk-txt .h2 a:hover { color: var(--accent); }
  .wk-n { margin: 0 0 12px; }
  .wk-kick { font-family: var(--sans); font-weight: 600; font-size: 21px; line-height: 1.3; margin: 14px 0 10px; }
  .wk-sum { color: var(--ink-2); margin: 0 0 14px; }
  .wk-more { display: inline-block; margin-top: 8px; }
  .work-all { margin: -40px 0 0; }

  /* approach */
  .approach { background: var(--night); color: var(--paper); margin-top: clamp(80px, 10vw, 140px); padding: clamp(60px, 8vw, 120px) 0; }
  .label.inv { border-top-color: var(--paper); }
  .label.inv .meta { color: var(--paper); }
  .label.inv .meta:last-child { color: #9b9387; }
  .ap-h { max-width: 16ch; margin-bottom: clamp(40px, 6vw, 80px); }
  .ap-h em { color: inherit; font-style: normal; }
  .ap-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 44px); }
  .ap-list li:nth-child(2) { margin-top: 60px; }
  .ap-list li:nth-child(3) { margin-top: 120px; }
  .ap-list .meta { color: #9b9387; margin: 16px 0 6px; }
  .ap-list p:last-child { color: #c9c1b4; margin: 10px 0 0; }

  /* about preview */
  .aboutp { padding-top: clamp(80px, 10vw, 150px); }
  .ab-grid { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(30px, 5vw, 80px); align-items: end; }
  .ab-quote { font-size: clamp(36px, 4.6vw, 70px); line-height: 1.02; }
  .ab-quote em { color: inherit; }
  .ab-txt p { color: var(--ink-2); margin: 0 0 1em; }

  /* contact sheet */
  .sheet { padding-top: clamp(80px, 10vw, 150px); }
  .sheet-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; align-items: start; }
  .sh { margin: 0; }
  .sh figcaption { margin-top: 6px; }
  .sh-1, .sh-6 { margin-top: 60px; }
  .sh-3 { margin-top: 30px; }
  .sheet-more { margin-top: 36px; }

  @media (max-width: 860px) {
    .wk { display: flex; flex-direction: column; align-items: stretch; }
    .wk-txt { margin-top: 18px; padding: 0 !important; }
    .wk-2 .wk-txt { display: block; }
    .work-all { margin-top: 0; }
    .ap-list { grid-template-columns: 1fr; }
    .ap-list li:nth-child(n) { margin-top: 0; }
    .ab-grid { grid-template-columns: 1fr; }
    .sheet-grid { grid-template-columns: 1fr 1fr; }
    .sh-1, .sh-6, .sh-3 { margin-top: 0; }
    .sh-1, .sh-5 { margin-top: 40px; }
  }
</style>
