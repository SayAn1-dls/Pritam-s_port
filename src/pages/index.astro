---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import HireCta from '../components/HireCta.astro';
import { site, companies } from '../data/site';
import { published } from '../data/projects';
import { photos, photoById } from '../data/photos';

const featured = published.filter((p) => p.featured);
const artists = [...new Set(published.map((p) => p.artist))];
// Real counts, computed from the content files (not typed in by hand).
const framesDelivered = published.reduce((n, p) => n + Number(p.outcomes.verified[0]?.match(/\d+/)?.[0] ?? 0), 0);
const archiveCount = photos.filter((p) => p.project !== 'pritam').length;
const sheet = ['cactus-dsc-0393', 'fossils-dsc-2023-l', 'monali-thakur-img-0952-l', 'jeet-ganguly-dsc-0103', 'fakira-dsc-0823', 'anupam-roy-220569', 'cactus-dsc-0241', 'fossils-dsc-2339-l']
  .map(photoById).filter(Boolean);
---
<Base>
  <!-- ============ COVER ============ -->
  <section class="cover wrap">

    <h1 class="display cover-h">
      The show lasts <span>three hours.</span>
      <em>The pictures sell the next one.</em>
    </h1>

    <div class="cover-photo">
      <div class="cover-frame">
        <Photo id="pritam-haldar-portrait" eager sizes="(max-width: 860px) 100vw, 40vw" lightbox />
        <p class="stamp" aria-hidden="true">Shoots it.<br />Sells it.</p>
      </div>
      <p class="cover-tag meta"><span class="accent">●</span> {site.name}, usually the one behind the camera</p>
    </div>

    <div class="cover-intro">
      <p class="lede">
        I’m {site.shortName}. I photograph concerts and turn those nights into marketing: content artists post,
        proof sponsors report on, and the frames promoters use to sell the next date.
      </p>
      <p class="cover-with">
        Working with <strong>{companies.map((c) => c.name).join(' & ')}</strong> on shows by {artists.slice(0, -1).join(', ')} and {artists.at(-1)}.
      </p>
      <div class="btns">
        <a class="btn" href="#work">Explore the work <span class="arr">↓</span></a>
        <a class="btn ghost" href="/hire/">Let’s work together <span class="arr">→</span></a>
      </div>
    </div>
  </section>

  <!-- ============ PROOF ============ -->
  <section class="proof wrap" aria-label="At a glance">
    <dl class="proof-row">
      <div><dt class="meta">Artists photographed live</dt><dd>{artists.length}</dd></div>
      <div><dt class="meta">Edited frames across these shows</dt><dd>{framesDelivered}</dd></div>
      <div><dt class="meta">Production partners</dt><dd>{companies.length}</dd></div>
      <div class="proof-names">
        <dt class="meta">On the bill</dt>
        <dd>{artists.map((a, i) => <span>{a}{i < artists.length - 1 && <i aria-hidden="true"> / </i>}</span>)}</dd>
      </div>
    </dl>
  </section>

  <!-- ============ SELECTED WORK ============ -->
  <section id="work" class="work wrap">
    <div class="label"><span class="meta">Selected work</span><span class="meta">{featured.length} shows</span></div>

    {featured.map((p, i) => (
      <article class:list={['wk', `wk-${i % 3}`, 'rv']}>
        <a href={`/work/${p.slug}/`} class="wk-img" aria-label={`${p.title}: read the case study`}>
          <Photo id={p.cover} ratio={i % 3 === 0 ? '3/2' : i % 3 === 1 ? '4/5' : '16/10'} sizes="(max-width: 860px) 100vw, 60vw" />
        </a>
        <div class="wk-txt">
          <p class="meta wk-n">{p.category}</p>
          <h2 class="h2"><a href={`/work/${p.slug}/`}>{p.artist}</a></h2>
          <p class="wk-kick">{p.kicker}</p>
          <p class="wk-sum">{p.summary}</p>
          <p class="meta">{[p.role, p.year].filter(Boolean).join(' · ')}</p>
          <a class="link-u wk-more" href={`/work/${p.slug}/`}>Read the case study →</a>
        </div>
      </article>
    ))}
    <p class="work-all"><a class="btn ghost" href="/work/">All work <span class="arr">→</span></a></p>
  </section>

  <!-- ============ APPROACH (dark) ============ -->
  <section class="approach">
    <div class="wrap">
      <div class="label inv"><span class="meta">How I work a show</span><span class="meta">Three frames, three audiences</span></div>
      <h2 class="h2 ap-h rv">A concert photo is a <em>marketing asset</em> with a deadline.</h2>
      <ol class="ap-list">
        <li class="rv">
          <Photo id="monali-thakur-img-0886-l" ratio="1/1" sizes="(max-width: 860px) 100vw, 30vw" />
          <p class="meta">The face</p>
          <h3 class="h3">For the artist</h3>
          <p>Emotion, a sharp frame and a flattering angle. The photo the artist posts that night, and the one fans share.</p>
        </li>
        <li class="rv">
          <Photo id="jeet-ganguly-dsc-0100" ratio="1/1" sizes="(max-width: 860px) 100vw, 30vw" />
          <p class="meta">The stage</p>
          <h3 class="h3">For the sponsor</h3>
          <p>Scale, production and the brand on the screen, readable. What the partner shows their boss on Monday.</p>
        </li>
        <li class="rv">
          <Photo id="fakira-dsc-0823" ratio="1/1" sizes="(max-width: 860px) 100vw, 30vw" />
          <p class="meta">The crowd</p>
          <h3 class="h3">For the promoter</h3>
          <p>Proof that people showed up and cared. It’s the most persuasive thing you can put on the poster for the next date.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ ABOUT PREVIEW ============ -->
  <section class="aboutp wrap">
    <div class="label"><span class="meta">About</span></div>
    <div class="ab-grid">
      <p class="display ab-quote rv">I stand where the crowd can’t, so the people who weren’t there <em>wish they had been.</em></p>
      <div class="ab-txt rv">
        <p>I work in the space between the stage and the marketing team. I shoot concerts, and I think about what each frame has to do after the lights come up: who will post it, who will pay for it, and who it should convince.</p>
        <p>Working with production companies means I see the whole machine: artists, sponsors, crews, and a crowd that has to be won all over again for every show.</p>
        <a class="link-u" href="/about/">More about me →</a>
      </div>
    </div>
  </section>

  <!-- ============ ARCHIVE PREVIEW (contact sheet) ============ -->
  <section class="sheet wrap">
    <div class="label"><span class="meta">From the archive</span><span class="meta">{archiveCount} frames online</span></div>
    <div class="sheet-grid">
      {sheet.map((p, i) => (
        <figure class:list={['sh', `sh-${i}`, 'rv']}>
          <Photo id={p!.id} ratio={i % 3 === 0 ? '4/5' : '3/2'} sizes="(max-width: 860px) 50vw, 25vw" lightbox />
          <figcaption class="meta">{p!.artist}</figcaption>
        </figure>
      ))}
    </div>
    <p class="sheet-more"><a class="btn" href="/archive/">Open the archive <span class="arr">→</span></a></p>
  </section>

  <HireCta />
</Base>

<style>
  /* cover */
  .cover {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 20px;
    padding-top: clamp(20px, 3vw, 40px);
    padding-bottom: clamp(40px, 6vw, 90px);
  }
  .cover-meta { grid-column: 1 / -1; display: flex; justify-content: space-between; border-bottom: 1px solid var(--ink); padding-bottom: 10px; margin-bottom: clamp(24px, 4vw, 56px); color: var(--ink); }
  .cover-h {
    grid-column: 1 / 9; grid-row: 2;
    font-size: clamp(64px, 10.6vw, 196px);
    position: relative; z-index: 2;
    text-wrap: balance;
  }
  .cover-h em { display: block; }
  .cover-photo { grid-column: 8 / 13; grid-row: 2 / 4; align-self: start; margin-top: clamp(0px, 6vw, 90px); }
  .cover-tag { margin: 10px 0 0; }
  .cover-frame { position: relative; }
  .stamp {
    position: absolute; right: -22px; top: 30px; margin: 0; z-index: 3;
    background: var(--accent); color: var(--accent-ink);
    font-family: var(--display); text-transform: uppercase; font-size: clamp(22px, 2vw, 32px); line-height: 0.95;
    padding: 12px 16px 10px; rotate: 5deg; box-shadow: 6px 6px 0 var(--ink);
  }
  .cover-intro { grid-column: 1 / 7; grid-row: 3; margin-top: clamp(28px, 4vw, 56px); }
  .cover-with { color: var(--grey); max-width: 46ch; margin: 18px 0 28px; }
  .cover-with strong { color: var(--ink); font-weight: 500; }

  /* proof */
  .proof-row {
    display: grid; grid-template-columns: repeat(3, auto) 1fr; gap: 0;
    margin: 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink);
  }
  .proof-row > div { padding: 20px 28px 22px 0; margin-right: 28px; border-right: 1px solid var(--rule); }
  .proof-row > div:last-child { border-right: 0; margin-right: 0; }
  .proof-row dd { margin: 6px 0 0; font-family: var(--display); font-size: clamp(52px, 6vw, 88px); line-height: 1; }
  .proof-names dd { font-size: clamp(24px, 2.4vw, 34px); line-height: 1.15; text-transform: uppercase; }
  .proof-names i { color: var(--accent); font-style: normal; }

  /* work */
  .work { padding-top: clamp(80px, 10vw, 150px); }
  .wk { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 20px; align-items: end; margin-bottom: clamp(70px, 9vw, 140px); }
  .wk-img { display: block; }
  .wk-0 .wk-img { grid-column: 1 / 9; }
  .wk-0 .wk-txt { grid-column: 9 / 13; }
  .wk-1 .wk-img { grid-column: 6 / 11; grid-row: 1; }
  .wk-1 .wk-txt { grid-column: 1 / 6; grid-row: 1; align-self: center; padding-right: 20px; }
  .wk-2 .wk-img { grid-column: 2 / 13; }
  .wk-2 .wk-txt { grid-column: 2 / 9; margin-top: 22px; display: grid; grid-template-columns: 1fr 1fr; column-gap: 30px; }
  .wk-2 .wk-txt > :is(.wk-n, .h2) { grid-column: 1 / -1; }
  .wk-txt .h2 a { text-decoration: none; }
  .wk-txt .h2 a:hover { color: var(--accent); }
  .wk-n { margin: 0 0 12px; }
  .wk-kick { font-family: var(--sans); font-weight: 600; font-size: 21px; line-height: 1.3; margin: 14px 0 10px; }
  .wk-sum { color: var(--ink-2); margin: 0 0 14px; }
  .wk-more { display: inline-block; margin-top: 8px; }
  .work-all { margin: -40px 0 0; }

  /* approach */
  .approach { background: var(--night); color: var(--paper); margin-top: clamp(80px, 10vw, 140px); padding: clamp(60px, 8vw, 120px) 0; }
  .label.inv { border-top-color: var(--paper); }
  .label.inv .meta { color: var(--paper); }
  .label.inv .meta:last-child { color: #9b9387; }
  .ap-h { max-width: 16ch; margin-bottom: clamp(40px, 6vw, 80px); }
  .ap-h em { color: var(--accent); font-style: normal; }
  .ap-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 44px); }
  .ap-list li:nth-child(2) { margin-top: 60px; }
  .ap-list li:nth-child(3) { margin-top: 120px; }
  .ap-list .meta { color: #9b9387; margin: 16px 0 6px; }
  .ap-list p:last-child { color: #c9c1b4; margin: 10px 0 0; }

  /* about preview */
  .aboutp { padding-top: clamp(80px, 10vw, 150px); }
  .ab-grid { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(30px, 5vw, 80px); align-items: end; }
  .ab-quote { font-size: clamp(36px, 4.6vw, 70px); line-height: 1.02; }
  .ab-quote em { color: var(--accent); }
  .ab-txt p { color: var(--ink-2); margin: 0 0 1em; }

  /* contact sheet */
  .sheet { padding-top: clamp(80px, 10vw, 150px); }
  .sheet-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; align-items: start; }
  .sh { margin: 0; }
  .sh figcaption { margin-top: 6px; }
  .sh-1, .sh-6 { margin-top: 60px; }
  .sh-3 { margin-top: 30px; }
  .sheet-more { margin-top: 36px; }

  @media (max-width: 860px) {
    .cover { display: flex; flex-direction: column; }
    .cover-h { font-size: clamp(58px, 17vw, 110px); }
    .cover-meta { gap: 12px; }
    .cover-meta span:last-child { white-space: nowrap; }
    .cover-photo { margin: 24px 0 0; order: 2; }
    .stamp { right: 10px; top: 16px; }
    .cover-intro { order: 3; margin-top: 24px; }
    .proof-row { grid-template-columns: 1fr 1fr; }
    .proof-row > div { padding: 16px 12px 16px 0; margin-right: 12px; border-bottom: 1px solid var(--rule); }
    .proof-row > div:nth-child(2) { border-right: 0; margin-right: 0; }
    .proof-names { grid-column: 1 / -1; border-bottom: 0 !important; }
    .wk { display: flex; flex-direction: column; align-items: stretch; }
    .wk-txt { margin-top: 18px; padding: 0 !important; }
    .wk-2 .wk-txt { display: block; }
    .work-all { margin-top: 0; }
    .ap-list { grid-template-columns: 1fr; }
    .ap-list li:nth-child(n) { margin-top: 0; }
    .ab-grid { grid-template-columns: 1fr; }
    .sheet-grid { grid-template-columns: 1fr 1fr; }
    .sh-1, .sh-6, .sh-3 { margin-top: 0; }
    .sh-1, .sh-5 { margin-top: 40px; }
  }
</style>
