---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import HireCta from '../../components/HireCta.astro';
import { published, type Project } from '../../data/projects';
import { photoById, fullSrc } from '../../data/photos';
import { site } from '../../data/site';

export function getStaticPaths() {
  return published.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
const idx = published.indexOf(p);
const next = published[(idx + 1) % published.length];
const prev = published[(idx - 1 + published.length) % published.length];
const cover = photoById(p.cover);
const seq = p.sequence.filter((id) => photoById(id));
const who = p.kind === 'band' ? 'the band' : 'the artist';
// The artist first, then the show Pritam photographed.
const facts = [
  ['From', p.origin],
  ['Genre', p.genre],
  ['Photographed', p.year],
  ['Edited frames', p.frames ? String(p.frames) : ''],
].filter(([, v]) => v);
// split the sequence into the editorial blocks of the page
const s = (a: number, b?: number) => seq.slice(a, b);
---
<Base title={p.artist} description={p.summary} image={cover ? fullSrc(cover, 1600) : undefined}>
  <article>
    <header class="cs-head wrap">
      <p class="meta crumbs"><a class="link-u" href="/work/">Work</a> / {p.artist}</p>
      <h1 class="display cs-t">{p.artist}</h1>
      <p class="cs-kick">{p.kicker}</p>
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt class="meta">{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </header>

    <div class="cs-cover wrap">
      <Photo id={p.cover} eager sizes="100vw" lightbox maxH="86svh" />
    </div>

    <section class="wrap cs-intro">
      <p class="lede cs-sum">{p.summary}</p>
    </section>

    <section class="wrap chap">
      <p class="meta chap-n">About {who}</p>
      <div class="prose"><p>{p.intro}</p></div>
    </section>

    <section class="wrap duo">
      {s(0, 2).map((id) => <Photo id={id} sizes="(max-width: 860px) 100vw, 50vw" lightbox />)}
    </section>

    <section class="wrap chap">
      <p class="meta chap-n">The sound</p>
      <div class="prose"><p>{p.sound}</p></div>
    </section>

    <section class="wrap chap chap-idea">
      <p class="meta chap-n">In one line</p>
      <p class="display idea">{p.statement}</p>
    </section>

    <section class="wrap trio">
      {s(2, 5).map((id) => <Photo id={id} sizes="(max-width: 860px) 100vw, 33vw" lightbox />)}
    </section>

    <section class="wrap chap">
      <p class="meta chap-n">Known for</p>
      <ol class="exec">
        {p.known.map((e) => <li><span class="meta" aria-hidden="true">—</span><span>{e}</span></li>)}
      </ol>
    </section>

    <section class="wrap wide">
      {s(5, 6).map((id) => <Photo id={id} sizes="100vw" lightbox />)}
    </section>

    <section class="wrap sheet" aria-label="Contact sheet">
      {s(6).map((id) => <Photo id={id} sizes="(max-width: 860px) 50vw, 25vw" lightbox />)}
    </section>

    <section class="wrap chap outcome">
      <p class="meta chap-n">On record</p>
      <div class="out-grid">
        <div>
          <h2 class="meta">Milestones</h2>
          <ul>{p.milestones.map((o) => <li>{o}</li>)}</ul>
        </div>
        <div>
          <h2 class="meta">Photographed by {site.name}</h2>
          <ul>
            {p.year && <li>Live, {p.year}</li>}
            {p.frames > 0 && <li>{p.frames} frames in the edited set</li>}
          </ul>
        </div>
      </div>
    </section>

    <nav class="wrap pn" aria-label="More work">
      <a href={`/work/${prev.slug}/`} class="pn-a"><span class="meta">← Previous</span><span class="pn-t">{prev.artist}</span></a>
      <a href={`/work/${next.slug}/`} class="pn-a pn-next"><span class="meta">Next →</span><span class="pn-t">{next.artist}</span></a>
    </nav>
  </article>
  <HireCta />
</Base>

<style>
  .cs-head { padding-top: clamp(30px, 5vw, 70px); }
  .crumbs { margin: 0 0 20px; }
  .cs-t { font-size: clamp(72px, 17vw, 300px); line-height: 0.84; }
  .cs-kick { font-family: var(--sans); font-weight: 600; font-size: clamp(22px, 2.6vw, 36px); color: var(--accent); margin: 16px 0 clamp(20px, 3vw, 34px); max-width: 30ch; }
  .facts {
    margin: 0 0 clamp(24px, 3vw, 40px); display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    column-gap: 28px; border-top: 6px solid var(--ink); max-width: 980px;
  }
  .facts div { padding: 12px 0 0; min-width: 0; }
  .facts dd { margin: 4px 0 0; font-size: 17px; font-weight: 650; }
  .cs-intro { padding-top: clamp(30px, 4vw, 60px); }
  .cs-sum { max-width: 46ch; margin: 0; }

  .chap { display: grid; grid-template-columns: 1fr 2fr; gap: 30px; padding-top: clamp(60px, 8vw, 120px); }
  .chap-n { margin: 6px 0 0; color: var(--ink); border-top: 6px solid var(--ink); padding-top: 10px; align-self: start; }
  .chap .prose p { font-size: clamp(19px, 1.6vw, 23px); line-height: 1.5; margin: 0; }
  .idea { font-size: clamp(32px, 3.8vw, 60px); line-height: 1; }

  .duo { display: grid; grid-template-columns: 1.3fr 1fr; gap: 16px; align-items: start; padding-top: clamp(50px, 6vw, 90px); }
  .duo > :nth-child(2) { margin-top: 15%; }
  .trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: start; padding-top: clamp(50px, 6vw, 90px); }
  .trio > :nth-child(2) { margin-top: 50px; }
  .wide { padding-top: clamp(50px, 6vw, 90px); }
  /* contact sheet: whole frames in columns, no cropping */
  .sheet { columns: 4; column-gap: 8px; padding-top: 8px; }
  .sheet > :global(*) { break-inside: avoid; margin-bottom: 8px; }

  .exec { list-style: none; margin: 0; padding: 0; }
  .exec li { display: grid; grid-template-columns: 40px 1fr; gap: 10px; padding: 14px 0; font-size: 18px; }
  .exec li .meta { padding-top: 5px; }

  .out-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .outcome h2 { margin: 0 0 10px; }
  .outcome h2 + ul { margin-bottom: 28px; }
  .outcome ul { padding: 0; list-style: none; margin: 0; }
  .outcome li { font-weight: 650; font-size: 20px; line-height: 1.35; padding: 10px 0; }

  .pn { display: grid; grid-template-columns: 1fr 1fr; margin-top: clamp(70px, 9vw, 130px); border-top: 6px solid var(--ink); }
  .pn-a { display: grid; gap: 6px; padding: 22px 0; text-decoration: none; }
  .pn-next { text-align: right; }
  .pn-t { font-family: var(--display); text-transform: uppercase; font-size: clamp(30px, 4vw, 60px); line-height: 1; transition: color 0.2s; }
  .pn-a:hover .pn-t { color: var(--accent); }

  @media (max-width: 860px) {
    .chap, .out-grid { grid-template-columns: 1fr; }
    .facts { grid-template-columns: 1fr 1fr; }
    .duo, .trio { grid-template-columns: 1fr; }
    .duo > :nth-child(2), .trio > :nth-child(2) { margin-top: 0; }
    .sheet { columns: 2; }
  }
</style>
